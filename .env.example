# Postgres (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fyp_project
POSTGRES_PORT=5432

# App database connection (must point at the same database as above)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fyp_project

NODE_ENV=development
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Gmail SMTP (password-reset + welcome emails). Use a Gmail App Password
# (not your normal password) — https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=

# AI/ML forecasting service (services/ml-service/) — must match its own ML_SERVICE_API_KEY
ML_SERVICE_URL=http://localhost:5001
ML_SERVICE_API_KEY=
